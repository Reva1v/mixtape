{
  "manifest_version": 3,
  "name": "Mixtape Link Catcher",
  "version": "1.0.0",
  "description": "Opens YouTube Music links from outside the site in Mixtape.",
  "key": "",
  "permissions": ["webNavigation", "storage"],
  "host_permissions": [
    "*://music.youtube.com/*",
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Mixtape Link Catcher", "default_popup": "popup.html" },
  "icons": { "32": "icons/32x32.png", "64": "icons/64x64.png", "128": "icons/128x128.png" }
}
